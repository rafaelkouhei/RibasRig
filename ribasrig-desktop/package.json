{
  "name": "ribasrig-desktop",
  "productName": "RibasRig",
  "version": "1.0.0",
  "description": "Sistema RibasRig — Planos de Rigging da Guindastes Ribas (aplicativo para o computador do escritório)",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:front": "node scripts/construir-front.mjs",
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "dev": "npm run build:front && npm start",
    "test": "tsc -p . && node --test \"dist/**/*.test.js\"",
    "fumaca": "npm run build && electron . --fumaca",
    "dist:win": "npm run build:front && npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build:front && npm run build && electron-builder --mac",
    "app:mac": "npm run build:front && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.10.1",
    "electron-builder": "26.18.1",
    "typescript": "~5.9"
  },
  "build": {
    "appId": "br.com.guindastesribas.ribasrig",
    "productName": "RibasRig",
    "copyright": "Guindastes Ribas Ltda.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*.js",
      "!dist/**/*.test.js",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "RibasRig"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
