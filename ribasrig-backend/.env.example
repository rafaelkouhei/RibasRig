# Copie para .env e ajuste. O .env NÃO vai para o repositório.

# Banco (o docker-compose sobe o PostgreSQL com estes dados)
POSTGRES_DB=ribasrig
POSTGRES_USER=ribasrig
POSTGRES_PASSWORD=troque-esta-senha

# Django. Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# "Hoje" das regras de negócio. Para a demonstração com o cenário de exemplo use 2026-10-07
# (o mesmo HOJE fixo do front). Deixe vazio para usar a data real (obrigatório num servidor dedicado de uso real).
RIBASRIG_HOJE=2026-10-07

# Senha dos usuários de teste (giuliano.breda e rigger.campo) criados por `carregar_exemplo`.
# Combine na equipe; vazio = o comando gera uma senha aleatória e mostra uma vez.
RIBASRIG_SENHA_TESTE=
