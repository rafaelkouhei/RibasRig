# Copie para .env e ajuste. O .env NÃO vai para o repositório.

# Banco (o docker-compose sobe o PostgreSQL com estes dados)
POSTGRES_DB=ribasrig
POSTGRES_USER=ribasrig
POSTGRES_PASSWORD=troque-esta-senha

# Django. Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# "Hoje" das regras de negócio. Vazio = data real (o certo para uso real).
# Só para a demonstração com o cenário de exemplo (carregar_exemplo) use 2026-10-07, o mesmo HOJE fixo do front:
# com a data fixa, os vencimentos e a numeração dos planos ficam parados nesse dia.
RIBASRIG_HOJE=

# Senha dos usuários de teste (giuliano.breda e rigger.campo) criados por `carregar_exemplo`.
# Combine na equipe; vazio = o comando gera uma senha aleatória e mostra uma vez.
RIBASRIG_SENHA_TESTE=
